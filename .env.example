# ==============================================================================
# GRANDHAM Environment Configuration
# ==============================================================================

# Optional canonical production base URL (defaults dynamically to the current request/browser origin)
# APP_URL=https://your-grandham-app.vercel.app

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Calendar OAuth (Server-side only - NEVER exposed to browser)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
