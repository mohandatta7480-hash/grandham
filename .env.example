# ==============================================================================
# GRANDHAM Environment Configuration
# ==============================================================================

# Canonical App URL (e.g. https://your-grandham-app.vercel.app in production)
# In development, defaults to http://localhost:3000
APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Calendar OAuth (Server-side only - NEVER exposed to browser)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
